---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import AdSense from '../components/AdSense.astro';
import PdfMetadata from '../components/tools/PdfMetadata';
---
<BaseLayout>
  <SEO slot="head" title="Edit PDF Metadata" description="View and edit PDF title, author, subject, and keywords." />
  <div class="max-w-4xl mx-auto px-4 py-8">
    <nav class="text-sm text-gray-500 mb-6"><a href="/" class="hover:text-primary-600">Home</a> <span class="mx-2">›</span> <span class="text-gray-900">Edit PDF Metadata</span></nav>
    <h1 class="text-3xl font-bold text-gray-900 mb-6">Edit PDF Metadata</h1>
    <PdfMetadata client:load />
    <AdSense slot="bottom" />
  </div>
</BaseLayout>
