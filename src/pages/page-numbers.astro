---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import AdSense from '../components/AdSense.astro';
import PageNumbers from '../components/tools/PageNumbers';
---
<BaseLayout>
  <SEO slot="head" title="Add Page Numbers" description="Add page numbers to the header or footer of your PDF." />
  <div class="max-w-4xl mx-auto px-4 py-8">
    <nav class="text-sm text-gray-500 mb-6"><a href="/" class="hover:text-primary-600">Home</a> <span class="mx-2">›</span> <span class="text-gray-900">Add Page Numbers</span></nav>
    <h1 class="text-3xl font-bold text-gray-900 mb-6">Add Page Numbers</h1>
    <PageNumbers client:load />
    <AdSense slot="bottom" />
  </div>
</BaseLayout>
