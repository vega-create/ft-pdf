---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import AdSense from '../components/AdSense.astro';
import RotatePdf from '../components/tools/RotatePdf';
---
<BaseLayout>
  <SEO slot="head" title="Rotate PDF Pages" description="Rotate PDF pages 90, 180, or 270 degrees." />
  <div class="max-w-4xl mx-auto px-4 py-8">
    <nav class="text-sm text-gray-500 mb-6"><a href="/" class="hover:text-primary-600">Home</a> <span class="mx-2">›</span> <span class="text-gray-900">Rotate PDF Pages</span></nav>
    <h1 class="text-3xl font-bold text-gray-900 mb-6">Rotate PDF Pages</h1>
    <RotatePdf client:load />
    <AdSense slot="bottom" />
  </div>
</BaseLayout>
