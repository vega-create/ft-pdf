---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import AdSense from '../components/AdSense.astro';
import PageSize from '../components/tools/PageSize';
---
<BaseLayout>
  <SEO slot="head" title="PDF Page Size" description="Resize PDF pages to A4, Letter, or custom dimensions." />
  <div class="max-w-4xl mx-auto px-4 py-8">
    <nav class="text-sm text-gray-500 mb-6"><a href="/" class="hover:text-primary-600">Home</a> <span class="mx-2">›</span> <span class="text-gray-900">PDF Page Size</span></nav>
    <h1 class="text-3xl font-bold text-gray-900 mb-6">PDF Page Size</h1>
    <PageSize client:load />
    <AdSense slot="bottom" />
  </div>
</BaseLayout>
